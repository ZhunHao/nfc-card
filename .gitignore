*.kicad_pcb-bak
*.sch-bak
fp-info-cache
~*.*
# KiCad autosave / lock
_autosave-*
*.lck
# Build & fab output (regenerated; keep released zips only)
*.o
*.elf
*.hex.tmp
# OS
.DS_Store
